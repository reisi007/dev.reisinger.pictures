---
import { useTranslations, defaultLang, type SupportedLanguage } from '../i18n/ui';

const lang = Astro.currentLocale || defaultLang;
const t = useTranslations(lang as SupportedLanguage);
const today = new Date();
---

<footer class="footer footer-center p-10 bg-base-200 text-base-content mt-20 border-t border-base-300">
	<aside>
		<p class="font-medium">&copy; {today.getFullYear()} Florian Reisinger. {t('footer.rights')}</p>
		<div class="flex gap-4 mt-2 opacity-70 text-sm">
			<a href="https://reisinger.pictures/impressum" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">Impressum</a>
			<span>•</span>
			<a href="/rss.xml" class="hover:text-primary transition-colors">RSS Feed</a>
		</div>
	</aside>
	<nav>
		<div class="grid grid-flow-col gap-4">
			<a href="https://reisinger.pictures" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle bg-base-300 hover:bg-primary hover:text-primary-content transition-colors">
				<span class="icon-[mdi--camera] text-2xl"></span>
				<span class="sr-only">reisinger.pictures</span>
			</a>
			<a href="https://github.com/reisi007" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle bg-base-300 hover:bg-neutral hover:text-neutral-content transition-colors">
				<span class="icon-[mdi--github] text-2xl"></span>
				<span class="sr-only">GitHub</span>
			</a>
		</div>
	</nav>
</footer>
