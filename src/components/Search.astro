---
// Pagefind UI Styles
---

<div id="search-container" class="w-full">
    <div id="search" class="w-full"></div>
</div>

<script is:inline>
    // Dynamischer Ladevorgang, damit der Dev-Server nicht abstürzt, wenn Pagefind noch nicht gebaut wurde
    window.addEventListener('DOMContentLoaded', () => {
        const initPagefind = async () => {
            try {
                // Lade CSS
                const link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = '/pagefind/pagefind-ui.css';
                document.head.appendChild(link);

                // Lade JS
                const script = document.createElement('script');
                script.src = '/pagefind/pagefind-ui.js';
                script.onload = () => {
                    if (window.PagefindUI) {
                        new window.PagefindUI({
                            element: "#search",
                            showSubResults: true,
                            showImages: false,
                            resetStyles: false // Erlaubt uns, das CSS leicht via Tailwind/Global zu überschreiben
                        });
                    }
                };
                document.head.appendChild(script);
            } catch (e) {
                console.warn('Pagefind konnte nicht geladen werden. Läuft der Dev-Server ohne vorherigen Build?', e);
            }
        };

        // Nur initialisieren, wenn das Modal geöffnet wird oder wir nicht im Dev-Mode Fehler provozieren wollen
        initPagefind();
    });
</script>

<style is:global>
    /* Anpassungen für DaisyUI / Tailwind Integration */
    :root {
        --pagefind-ui-scale: 1;
        --pagefind-ui-primary: var(--color-primary);
        --pagefind-ui-text: var(--color-base-content);
        --pagefind-ui-background: var(--color-base-100);
        --pagefind-ui-border: var(--color-base-300);
        --pagefind-ui-border-width: 1px;
        --pagefind-ui-border-radius: var(--radius-box);
        --pagefind-ui-font: inherit;
    }
    
    .pagefind-ui__search-input {
        background-color: var(--color-base-200) !important;
        outline: none !important;
    }
    .pagefind-ui__search-input:focus {
        border-color: var(--color-primary) !important;
    }
    .pagefind-ui__result-title a {
        color: var(--color-primary) !important;
        text-decoration: none;
        font-weight: 700;
    }
    .pagefind-ui__result-title a:hover {
        opacity: 0.8;
    }
    .pagefind-ui__message {
        padding: 1rem 0;
        opacity: 0.7;
    }
</style>
