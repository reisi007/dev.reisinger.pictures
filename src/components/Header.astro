---
import {getRelativeLocaleUrl} from 'astro:i18n';
import {useTranslations,  type SupportedLanguage} from '../i18n/ui';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';

interface Props {
    alternateUrl?: string;
}

const {alternateUrl} = Astro.props;
const lang = Astro.currentLocale || "not found";
const t = useTranslations(lang as SupportedLanguage);
const currentPath = Astro.url.pathname;

console.log(lang)

const deUrl = lang === 'de' ? currentPath : alternateUrl;
const enUrl = lang === 'en' ? currentPath : alternateUrl;
---

<header class="sticky top-0 z-50 bg-base-100/90 backdrop-blur border-b border-base-200">
    <div class="navbar container mx-auto">
        <div class="navbar-start">
            <div class="dropdown">
                <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
                    <span class="icon-[mdi--menu] text-2xl"></span>
                </div>
                <ul tabindex="0"
                    class="menu menu-sm dropdown-content mt-3 z-1 p-2 shadow bg-base-100 rounded-box w-52 text-base-content">
                    <li>
                        <HeaderLink href={getRelativeLocaleUrl(lang, '/')}>{t('nav.home')}</HeaderLink>
                    </li>
                    <li>
                        <HeaderLink href={getRelativeLocaleUrl(lang, 'about')}>{t('nav.about')}</HeaderLink>
                    </li>
                </ul>
            </div>
            <a href={getRelativeLocaleUrl(lang, '/')} class="flex items-center gap-3 px-2 group no-underline">
                <img src="/android-chrome-192x192.png" alt="Logo"
                     class="size-8 md:size-10 rounded-lg shadow-sm group-hover:scale-105 transition-transform"/>
                <span class="text-xl font-bold text-primary tracking-tight">{t('site.title')}</span>
            </a>
        </div>
        <div class="navbar-center hidden lg:flex">
            <ul class="menu menu-horizontal px-1 gap-2 text-base">
                <li>
                    <HeaderLink href={getRelativeLocaleUrl(lang, '/')}>{t('nav.home')}</HeaderLink>
                </li>
                <li>
                    <HeaderLink href={getRelativeLocaleUrl(lang, 'about')}>{t('nav.about')}</HeaderLink>
                </li>
            </ul>
        </div>
        <div class="navbar-end gap-2">
            {deUrl !== undefined && enUrl !== undefined && (
                    <div class="join border border-base-300">
                        <a href={deUrl}
                           class={`join-item btn btn-xs ${lang === 'de' ? 'btn-primary' : 'btn-ghost'}`}>DE</a>
                        <a href={enUrl}
                           class={`join-item btn btn-xs ${lang === 'en' ? 'btn-primary' : 'btn-ghost'}`}>EN</a>
                    </div>
            )}

            <div class="w-32 sm:w-48 md:w-64 relative z-50">
                <Search/>
            </div>

            <a href="https://reisinger.pictures" target="_blank" class="btn btn-ghost btn-circle tooltip tooltip-bottom"
               data-tip="Portfolio">
                <span class="icon-[mdi--camera] text-2xl"></span>
                <span class="sr-only">reisinger.pictures</span>
            </a>
            <a href="https://github.com/reisi007" target="_blank"
               class="btn btn-ghost btn-circle hidden sm:flex tooltip tooltip-bottom" data-tip="GitHub">
                <span class="icon-[mdi--github] text-2xl"></span>
                <span class="sr-only">GitHub</span>
            </a>
        </div>
    </div>
</header>
