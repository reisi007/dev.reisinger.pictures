---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt?: string;
    class?: string;
    widths?: number[];
    sizes?: string;
    loading?: 'lazy' | 'eager';
    format?: 'webp' | 'jpg' | 'png' | 'avif';
    [key: string]: any; // Erlaubt beliebige zusätzliche Attribute wie data-pagefind-meta
}

const {
    src,
    alt = '',
    class: classNames,
    widths = [400, 800, 1200, 1920],
    sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 1200px',
    loading = 'lazy',
    format = 'webp',
    ...rest // Fängt alle restlichen Attribute ab
} = Astro.props;
---

<Image
    src={src}
    alt={alt}
    class={classNames}
    widths={widths}
    sizes={sizes}
    format={format}
    quality="mid"
    loading={loading}
    {...rest}
/>
