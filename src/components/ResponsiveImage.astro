---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt?: string;
    class?: string;
    widths?: number[];
    sizes?: string;
    loading?: 'lazy' | 'eager';
}

const {
    src,
    alt = '',
    class: classNames,
    widths = [400, 800, 1200, 1920],
    sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 1200px',
    loading = 'lazy'
} = Astro.props;
---

<Image
    src={src}
    alt={alt}
    class={classNames}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality="mid"
    loading={loading}
/>
