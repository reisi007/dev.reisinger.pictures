---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname;

// Trailing Slashes entfernen für verlässlichen Vergleich
const cleanPathname = pathname.replace(/\/$/, '') || '/';
const cleanHref = String(href).replace(/\/$/, '') || '/';

// Ist der Link die Startseite (egal ob DE oder EN)?
const isRootNode = cleanHref === '/' || cleanHref === '/en';

// Active, wenn exakter Match, ODER wenn es ein Unterbereich ist (z.B. /en/themen/...)
const isActive = cleanPathname === cleanHref || (!isRootNode && cleanPathname.startsWith(cleanHref + '/'));
---

<a href={href} class:list={[className, { 'active font-bold text-primary': isActive }]} {...props}>
	<slot />
</a>
