---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { taxonomyConfigs, getPostsByTaxonomy } from '../../../utils/taxonomy';
import { useTranslations, type SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
    const themen = await getCollection('themen');
    const tags = await getCollection('tags');
    const allPosts = await getCollection('blog');

    return taxonomyConfigs.map(c => {
        const items = c.type === 'themen' ? themen : tags;
        const postMap = getPostsByTaxonomy(allPosts, c.type, c.lang);
        
        const activeItems = items.filter(item => (postMap.get(item.id)?.length || 0) > 0);

        const alternateUrl = c.altLang === 'de' ? `/${c.altTaxonomySegment}/` : `/${c.altLang}/${c.altTaxonomySegment}/`;
        return {
            params: { lang: c.urlLang, taxonomy: c.taxonomySegment },
            props: { taxonomyType: c.type, currentLang: c.lang, items: activeItems, postMap, alternateUrl }
        };
    });
}

const { taxonomyType, currentLang, items, postMap, alternateUrl } = Astro.props;
const lang = currentLang as SupportedLanguage;
const t = useTranslations(lang);

const sortedItems = items.sort((a, b) => a.data[lang].name.localeCompare(b.data[lang].name));

const isTag = taxonomyType === 'tags';
const title = isTag ? t('taxonomy.tags.title') : t('taxonomy.topics.title');
const subtitle = isTag ? t('taxonomy.tags.subtitle') : t('taxonomy.topics.subtitle');
const taxonomyRoute = isTag ? t('route.tags') : t('route.themen');
---
<BaseLayout title={title} alternateUrl={alternateUrl} pagefindIgnore={true}>
    <div class="max-w-4xl mx-auto">
        <div class="mb-10 border-b border-base-300 pb-6 text-center">
            <h1 class="text-4xl md:text-5xl font-black text-base-content tracking-tight">{title}</h1>
            <p class="text-base-content/70 mt-3">{subtitle}</p>
        </div>
        <div class="flex flex-wrap justify-center gap-4">
            {sortedItems.map(item => {
                const count = postMap.get(item.id)?.length || 0;
                const loc = item.data[lang];
                const href = getRelativeLocaleUrl(lang, `${taxonomyRoute}/${loc.slug}/`);
                
                return isTag ? (
                    <a href={href} class="badge badge-lg badge-neutral hover:badge-primary transition-colors py-4 px-4">
                        <span class="icon-[mdi--tag-outline] mr-1"></span> {loc.name}
                        <span class="opacity-50 ml-2 text-xs">({count})</span>
                    </a>
                ) : (
                    <a href={href} class="btn btn-outline btn-primary">
                        {loc.name} <div class="badge badge-sm">{count}</div>
                    </a>
                );
            })}
        </div>
    </div>
</BaseLayout>
