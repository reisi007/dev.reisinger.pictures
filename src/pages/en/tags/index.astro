---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

const allTags = await getCollection('tags');
const allPosts = await getCollection('blog');
const currentLang = 'en';
const alternateUrl = getRelativeLocaleUrl('de', 'tags/');

const sortedTags = allTags.sort((a, b) => a.data[currentLang].name.localeCompare(b.data[currentLang].name));
---
<BaseLayout title="All Tags" alternateUrl={alternateUrl}>
    <div class="max-w-4xl mx-auto">
        <div class="mb-10 border-b border-base-300 pb-6 text-center">
            <h1 class="text-4xl md:text-5xl font-black text-base-content tracking-tight">Tags</h1>
            <p class="text-base-content/70 mt-3">All tags at a glance.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
            {sortedTags.map(tag => {
                const count = allPosts.filter(p => p.data.lang === currentLang && p.data.tags.some(t => t.id === tag.id)).length;
                const loc = tag.data[currentLang];
                return (
                        <a href={getRelativeLocaleUrl(currentLang, `tags/${loc.slug}/`)} class="badge badge-lg badge-neutral hover:badge-primary transition-colors py-4 px-4">
                            <span class="icon-[mdi--tag-outline] mr-1"></span> {loc.name}
                            <span class="opacity-50 ml-2 text-xs">({count})</span>
                        </a>
                );
            })}
        </div>
    </div>
</BaseLayout>