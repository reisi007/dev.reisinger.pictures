---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

const allThemen = await getCollection('themen');
const allPosts = await getCollection('blog');
const currentLang = 'en';
const alternateUrl = getRelativeLocaleUrl('de', 'themen/');

const sortedThemen = allThemen.sort((a, b) => a.data[currentLang].name.localeCompare(b.data[currentLang].name));
---
<BaseLayout title="All Topics" alternateUrl={alternateUrl}>
    <div class="max-w-4xl mx-auto">
        <div class="mb-10 border-b border-base-300 pb-6 text-center">
            <h1 class="text-4xl md:text-5xl font-black text-base-content tracking-tight">Topics</h1>
            <p class="text-base-content/70 mt-3">All categories at a glance.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-4">
            {sortedThemen.map(thema => {
                const count = allPosts.filter(p => p.data.thema.id === thema.id).length;
                const loc = thema.data[currentLang];
                return (
                        <a href={getRelativeLocaleUrl(currentLang, `topics/${loc.slug}/`)} class="btn btn-outline btn-primary">
                            {loc.name} <div class="badge badge-sm">{count}</div>
                        </a>
                );
            })}
        </div>
    </div>
</BaseLayout>