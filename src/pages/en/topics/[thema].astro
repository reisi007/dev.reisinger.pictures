---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getBlogUrl } from '../../../utils/url';

export async function getStaticPaths() {
    const allThemen = await getCollection('themen');
    const allPosts = await getCollection('blog');
    const currentLang = 'en';
    const altLang = 'de';
    const altRoute = 'themen';
    
    return allThemen.map((themaEntry) => {
        const filteredPosts = allPosts.filter((post) => post.data.lang === currentLang && post.data.thema.id === themaEntry.id);
        const alternateUrl = getRelativeLocaleUrl(altLang, `${altRoute}/${themaEntry.data[altLang].slug}/`);
        
        return {
            params: { thema: themaEntry.data[currentLang].slug },
            props: { themaEntry, posts: filteredPosts, alternateUrl },
        };
    });
}

const { themaEntry, posts, alternateUrl } = Astro.props;
const lang = 'en';
const localization = themaEntry.data[lang];
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title={`Topic: ${localization.name}`} alternateUrl={alternateUrl}>
    <div class="max-w-4xl mx-auto">
        <div class="mb-10">
            <a href={getRelativeLocaleUrl(lang, 'topics/')} class="btn btn-ghost btn-sm mb-6 pl-0 hover:bg-transparent hover:text-primary">
                <span class="icon-[mdi--arrow-left] text-lg"></span> Back to overview
            </a>
            <h1 class="text-3xl md:text-5xl font-black text-base-content">
                Posts about: <span class="text-primary">{localization.name}</span>
            </h1>
            <div class="text-base-content/70 mt-2">{posts.length === 1 ? '1 post' : `${posts.length} posts`} found</div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {sortedPosts.map(post => (
                <a href={getBlogUrl(post)} class="card bg-base-200 hover:bg-base-300 transition-colors shadow-sm hover:shadow-md overflow-hidden">
                    {post.data.heroImage && (
                            <figure class="aspect-video overflow-hidden">
                                <ResponsiveImage
                                        src={post.data.heroImage}
                                        alt={post.data.title}
                                        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                                        class="object-cover w-full h-full"
                                />
                            </figure>
                    )}
                    <div class="card-body p-6">
                        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary mb-2">
                            <span class="icon-[mdi--calendar-blank] text-base"></span>
                            <FormattedDate date={post.data.pubDate} />
                        </div>
                        <h2 class="card-title text-xl leading-tight">{post.data.title}</h2>
                    </div>
                </a>
            ))}
        </div>
    </div>
</BaseLayout>
