---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getBlogUrl } from '../../utils/url';

export async function getStaticPaths() {
    const allTags = await getCollection('tags');
    const allPosts = await getCollection('blog');

    return allTags.map((tagEntry) => {
        const filteredPosts = allPosts.filter((post) => post.data.lang === 'de' && post.data.tags.some(t => t.id === tagEntry.id));
        const alternateUrl = getRelativeLocaleUrl('en', `tags/${tagEntry.data.en.slug}/`);

        return {
            params: { tag: tagEntry.data.de.slug },
            props: { tagEntry, posts: filteredPosts, alternateUrl },
        };
    });
}

const { tagEntry, posts, alternateUrl } = Astro.props;
const localization = tagEntry.data.de;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title={`Tag: ${localization.name}`} alternateUrl={alternateUrl}>
    <div class="max-w-4xl mx-auto">
        <div class="mb-10">
            <a href={getRelativeLocaleUrl('de', 'tags/')} class="btn btn-ghost btn-sm mb-6 pl-0 hover:bg-transparent hover:text-primary">
                <span class="icon-[mdi--arrow-left] text-lg"></span> Alle Tags
            </a>
            <h1 class="text-3xl md:text-5xl font-black text-base-content flex items-center gap-3">
                <span class="icon-[mdi--tag-outline] text-4xl opacity-50"></span>
                <span class="text-primary">{localization.name}</span>
            </h1>
            <div class="text-base-content/70 mt-2">{posts.length === 1 ? '1 Beitrag' : `${posts.length} Beiträge`} gefunden</div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {sortedPosts.map(post => (
                    <a href={getBlogUrl(post)} class="card bg-base-200 hover:bg-base-300 transition-colors shadow-sm hover:shadow-md overflow-hidden">
                        {post.data.heroImage && (
                                <figure class="aspect-video overflow-hidden">
                                    <ResponsiveImage
                                            src={post.data.heroImage}
                                            alt={post.data.title}
                                            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                                            class="object-cover w-full h-full"
                                    />
                                </figure>
                        )}
                        <div class="card-body p-6">
                            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary mb-2">
                                <span class="icon-[mdi--calendar-blank] text-base"></span>
                                <FormattedDate date={post.data.pubDate} />
                            </div>
                            <h2 class="card-title text-xl leading-tight">{post.data.title}</h2>
                        </div>
                    </a>
            ))}
        </div>
    </div>
</BaseLayout>