---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))].sort();
---

<BaseLayout title="Alle Tags" description="Übersicht aller Blog-Stichwörter">
    <div class="max-w-4xl mx-auto">
        <div class="mb-10 border-b border-base-300 pb-6 text-center">
            <h1 class="text-4xl md:text-5xl font-black text-base-content tracking-tight">Tags</h1>
            <p class="text-base-content/70 mt-3">Alle Stichwörter dieses Blogs auf einen Blick.</p>
        </div>
        
        <div class="flex flex-wrap justify-center gap-3">
            {uniqueTags.map(tag => {
                const count = allPosts.filter(p => p.data.tags?.includes(tag)).length;
                return (
                    <a href={`/tags/${tag}/`} class="badge badge-lg badge-neutral hover:badge-primary transition-colors py-4 px-4">
                        <span class="icon-[mdi--tag-outline] mr-1"></span> {tag}
                        <span class="opacity-50 ml-2 text-xs">({count})</span>
                    </a>
                );
            })}
        </div>
    </div>
</BaseLayout>
