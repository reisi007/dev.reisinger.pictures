---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

interface ArchivePath {
    params: { slug: string };
    props: { type: string; filterName: string; posts: CollectionEntry<'blog'>[] };
}

interface Props {
    type: string;
    filterName: string;
    posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
    const allPosts = await getCollection('blog');
    const paths: ArchivePath[] = [];

    allPosts.forEach(post => {
        const d = post.data.pubDate;
        const year = d.getFullYear().toString();
        const month = (d.getMonth() + 1).toString().padStart(2, '0');
        const day = d.getDate().toString().padStart(2, '0');

        // Jahr
        paths.push({ params: { slug: year }, props: { type: 'Jahr', filterName: year, posts: [] } });
        // Jahr/Monat
        paths.push({ params: { slug: `${year}/${month}` }, props: { type: 'Monat', filterName: `${month}/${year}`, posts: [] } });
        // Jahr/Monat/Tag
        paths.push({ params: { slug: `${year}/${month}/${day}` }, props: { type: 'Tag', filterName: `${day}.${month}.${year}`, posts: [] } });
    });

    // Deduplizieren und zugehörige Posts filtern
    const uniquePaths = Array.from(new Map(paths.map(p => [p.params.slug, p])).values());
    
    return uniquePaths.map((pathDef: ArchivePath) => {
        const pathSlug = pathDef.params.slug;
        const filteredPosts = allPosts.filter(post => {
            const d = post.data.pubDate;
            const y = d.getFullYear().toString();
            const m = (d.getMonth() + 1).toString().padStart(2, '0');
            const day = d.getDate().toString().padStart(2, '0');
            
            if (pathDef.props.type === 'Jahr') return y === pathSlug;
            if (pathDef.props.type === 'Monat') return `${y}/${m}` === pathSlug;
            if (pathDef.props.type === 'Tag') return `${y}/${m}/${day}` === pathSlug;
            return false;
        });

        // Posts chronologisch absteigend sortieren
        filteredPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

        return {
            ...pathDef,
            props: { ...pathDef.props, posts: filteredPosts }
        };
    });
}

// const { slug } = Astro.params; // Entfernt aufgrund ts(6133)
const { type, filterName, posts } = Astro.props;
---

<BaseLayout title={`Archiv: ${filterName}`}>
    <div class="max-w-4xl mx-auto">
        <div class="mb-10">
            <a href="/archiv/" class="btn btn-ghost btn-sm mb-6 pl-0 hover:bg-transparent hover:text-primary">
                <span class="icon-[mdi--arrow-left] text-lg"></span> Komplettes Archiv
            </a>
            <h1 class="text-3xl md:text-5xl font-black text-base-content">
                Beiträge im <span class="text-primary opacity-80">{type}</span> {filterName}
            </h1>
            <div class="text-base-content/70 mt-2">{posts.length} Beitrag/Beiträge gefunden</div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {posts.map((post) => (
                <a href={`/blog/${post.id}/`} class="card bg-base-200 hover:bg-base-300 transition-colors shadow-sm hover:shadow-md">
                    <div class="card-body p-6">
                        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary mb-2">
                            <span class="icon-[mdi--calendar-blank] text-base"></span>
                            <FormattedDate date={post.data.pubDate} />
                        </div>
                        <h2 class="card-title text-xl leading-tight">{post.data.title}</h2>
                        {post.data.description && <p class="text-sm opacity-80 mt-2 line-clamp-2">{post.data.description}</p>}
                    </div>
                </a>
            ))}
        </div>
    </div>
</BaseLayout>
