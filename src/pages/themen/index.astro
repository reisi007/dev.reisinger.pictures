---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const uniqueThemen = [...new Set(allPosts.flatMap((post) => post.data.themen || []))].sort();
---

<BaseLayout title="Alle Themen" description="Übersicht aller Blog-Themen">
    <div class="max-w-4xl mx-auto">
        <div class="mb-10 border-b border-base-300 pb-6 text-center">
            <h1 class="text-4xl md:text-5xl font-black text-base-content tracking-tight">Themen</h1>
            <p class="text-base-content/70 mt-3">Alle Kategorien dieses Blogs auf einen Blick.</p>
        </div>
        
        <div class="flex flex-wrap justify-center gap-4">
            {uniqueThemen.map(thema => {
                const count = allPosts.filter(p => p.data.themen?.includes(thema)).length;
                return (
                    <a href={`/themen/${thema}/`} class="btn btn-outline btn-primary">
                        {thema}
                        <div class="badge badge-sm">{count}</div>
                    </a>
                );
            })}
        </div>
    </div>
</BaseLayout>
