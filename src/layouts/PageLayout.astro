---
import BaseLayout from './BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'simple'>['data'] & { alternateUrl?: string };

const { title, description, heroImage, alternateUrl } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage?.src} alternateUrl={alternateUrl}>
    <article>
        {heroImage && (
            <div class="w-full mb-8">
                <ResponsiveImage src={heroImage} sizes="(max-width: 1024px) 100vw, 1020px" loading="eager" class="block mx-auto rounded-xl shadow-lg object-cover w-full aspect-video" />
            </div>
        )}
        <div class="max-w-3xl mx-auto">
            <div class="mb-8 py-4 text-center leading-tight">
                <h1 class="text-3xl md:text-5xl font-black mt-2 mb-6 text-base-content">{title}</h1>
                <hr class="border-base-300 my-8" />
            </div>
            <div class="prose prose-base md:prose-lg prose-img:rounded-xl prose-a:text-primary hover:prose-a:text-primary/80 mx-auto max-w-none">
                <slot />
            </div>
        </div>
    </article>
</BaseLayout>
