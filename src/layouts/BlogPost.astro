---
import BaseLayout from './BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getEntry, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';

type Props = CollectionEntry<'blog'>['data'] & { alternateUrl?: string };

const { title, description, pubDate, updatedDate, heroImage, alternateUrl, thema, tags } = Astro.props;

const lang = (Astro.currentLocale || 'de') as 'de' | 'en';

// Wichtig: Wir übergeben explicitly Collection-Name und ID, um Fehler zu vermeiden.
const resolvedThema = thema?.id ? await getEntry('themen', thema.id) : null;

// Tags laden
// Optimiertes SEO-Bild generieren
const optimizedOgImage = heroImage ? await getImage({ src: heroImage, format: 'jpg', width: 1200 }) : null;
const ogImageUrl = optimizedOgImage ? optimizedOgImage.src : undefined;

const resolvedTags = await Promise.all(
    (tags || []).map(tag => getEntry('tags', tag.id))
).then(results => results.filter((t): t is NonNullable<typeof t> => t !== null && t !== undefined));
---

<BaseLayout title={title} description={description} image={ogImageUrl} alternateUrl={alternateUrl}>
    <article>
        {heroImage && (
                <div class="w-full mb-8">
                    <ResponsiveImage data-pagefind-meta="image[src]" src={heroImage} format="jpg" sizes="(max-width: 1024px) 100vw, 1020px" loading="eager" class="block mx-auto rounded-xl shadow-lg object-cover w-full aspect-video" />
                </div>
        )}
        <div class="max-w-3xl mx-auto">
            <div class="mb-8 py-4 text-center leading-tight">
                <div class="mb-2 text-base-content/60 text-sm font-medium flex justify-center items-center gap-2">
                    <span class="icon-[mdi--calendar-blank] text-base"></span>
                    <FormattedDate date={pubDate} />

                    {resolvedThema && (
                            <>
                                <span>•</span>
                                <a
                                        href={getRelativeLocaleUrl(lang, `${lang === 'de' ? 'themen' : 'topics'}/${resolvedThema.data[lang].slug}/`)}
                                        class="hover:text-primary transition-colors no-underline font-bold"
                                >
                                    {resolvedThema.data[lang].name}
                                </a>
                            </>
                    )}

                    {
                        updatedDate && (
                                    <div class="italic">
                                        (Zuletzt aktualisiert am <FormattedDate date={updatedDate} />)
                                    </div>
                        )
                    }
                </div>
                <h1 class="text-3xl md:text-5xl font-black mt-2 mb-6 text-base-content">{title}</h1>
                <hr class="border-base-300 my-8" />
            </div>
            <div class="prose prose-base md:prose-lg prose-img:rounded-xl prose-a:text-primary hover:prose-a:text-primary/80 mx-auto max-w-none">
                <slot />
            </div>
        </div>

        {resolvedTags.length > 0 && (
                <div class="mt-12 flex flex-wrap gap-2 max-w-3xl mx-auto border-t border-base-300 pt-6">
                    {resolvedTags.map(tag => (
                            <a
                                    href={getRelativeLocaleUrl(lang, `tags/${tag.data[lang].slug}/`)}
                                    class="badge badge-neutral hover:badge-primary transition-colors no-underline py-3 px-4"
                            >
                                <span class="icon-[mdi--tag-outline] mr-1"></span> {tag.data[lang].name}
                            </a>
                    ))}
                </div>
        )}
    </article>
</BaseLayout>