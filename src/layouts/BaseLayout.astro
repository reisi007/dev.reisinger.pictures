---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
    title: string;
    description?: string;
    image?: string;
    alternateUrl?: string;
    pagefindIgnore?: boolean;
}

const { title, description, image, alternateUrl, pagefindIgnore } = Astro.props;
const currentLang = Astro.currentLocale || 'de';
---

<html lang={currentLang}>
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>

	<body class="min-h-screen flex flex-col bg-base-100 text-base-content selection:bg-primary selection:text-primary-content" {...(pagefindIgnore ? {'data-pagefind-ignore': 'all'} : {})}>
		<Header alternateUrl={alternateUrl} />
		<main class="grow container mx-auto px-4 py-8 lg:py-12 max-w-5xl">
            <slot />
		</main>
		<Footer />
	</body>
</html>
